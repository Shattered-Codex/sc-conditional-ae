<section class="sc-cae-settings-shell" data-theme="verdant" data-screen-label="{{header.title}}" data-application-part="main">
  <div class="sc-cae-settings-body">
    <p class="sc-cae-settings-intro">{{header.intro}}</p>

    {{#if daeWarning}}
      <aside class="sc-cae-settings-note" role="note">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <div>
          <strong>{{daeWarning.title}}</strong>
          <p>{{daeWarning.text}}</p>
        </div>
      </aside>
    {{/if}}

    {{#each sections}}
      <section class="sc-cae-settings-section">
        <header class="sc-cae-settings-section__header">
          <h3 class="sc-cae-settings-section__title">{{this.title}}</h3>
          {{#if this.description}}
            <p class="sc-cae-settings-section__hint">{{this.description}}</p>
          {{/if}}
          {{#if this.permissionNote}}
            <p class="sc-cae-settings-section__lock">
              <i class="fa-solid fa-lock" aria-hidden="true"></i>
              <span>{{this.permissionNote}}</span>
            </p>
          {{/if}}
        </header>

        <div class="sc-cae-settings-rows">
          {{#each this.fields}}
            <label class="sc-cae-settings-row {{#if this.disabled}}is-disabled{{/if}}">
              <span class="sc-cae-settings-row__copy">
                <span class="sc-cae-settings-row__label">{{this.name}}</span>
                {{#if this.hint}}
                  <span class="sc-cae-settings-row__hint">{{this.hint}}</span>
                {{/if}}
              </span>

              <input
                type="checkbox"
                name="{{this.key}}"
                {{#if this.checked}}checked{{/if}}
                {{#if this.disabled}}disabled{{/if}}
              >
              <span class="sc-cae-settings-check" aria-hidden="true"></span>
            </label>
          {{/each}}
        </div>
      </section>
    {{/each}}
  </div>

  <footer class="sc-cae-settings-footer">
    <span class="sc-cae-settings-footer__spacer"></span>
    <button type="button" class="sc-cae-settings-button sc-cae-settings-button--ghost" data-action="cancel">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      <span>{{strings.cancel}}</span>
    </button>
    <button type="submit" class="sc-cae-settings-button sc-cae-settings-button--primary">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      <span>{{strings.save}}</span>
    </button>
  </footer>
</section>
