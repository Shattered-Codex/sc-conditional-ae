<section class="tab scrollable {{#if tab.active}}active{{/if}} sc-cae-condition-tab" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  <fieldset>
    <legend>{{ strings.heading }}</legend>
    {{#if useNativeAdvancedEditor}}
    <p class="note info">
      <i class="fa-solid fa-filter"></i>
      {{ strings.advancedEditorHint }}
    </p>

    {{#if conditionSummary}}
    <div class="sc-cae-condition-summary" data-state="{{ conditionSummary.state }}">
      <div class="sc-cae-condition-summary__header">
        <span class="sc-cae-condition-summary__title">{{ strings.summaryHeading }}</span>
        <span class="sc-cae-condition-summary__counts">
          {{#each conditionSummary.counts}}
          <span class="sc-cae-condition-summary__count" data-state="{{ this.state }}" data-tooltip="{{ this.label }}">
            <i class="fa-solid {{ this.icon }}" aria-hidden="true"></i>{{ this.count }}
          </span>
          {{/each}}
        </span>
      </div>

      {{#if conditionSummary.isEmpty}}
      <p class="hint sc-cae-condition-summary__empty">{{ strings.summaryEmpty }}</p>
      {{else}}
      <ul class="sc-cae-condition-summary__list">
        {{#each conditionSummary.rows}}
        <li class="sc-cae-condition-summary__row" data-state="{{ this.state }}" data-scope="{{ this.scope }}">
          <i class="fa-solid {{ this.stateIcon }} sc-cae-condition-summary__icon" aria-hidden="true"></i>
          <span class="sc-cae-condition-summary__label"
                {{~#if this.key}} data-tooltip="{{ this.key }}"{{/if}}>{{ this.label }}</span>
          <span class="sc-cae-condition-summary__layers">
            {{#each this.layers}}
            <span class="sc-cae-condition-summary__layer" data-state="{{ this.state }}"
                  data-tooltip="{{ this.stateLabel }}">{{ this.label }}</span>
            {{/each}}
          </span>
          <span class="sc-cae-condition-summary__state">{{ this.stateLabel }}</span>
          {{#if this.message}}
          <span class="sc-cae-condition-summary__message">
            <strong>{{ this.messageLabel }}:</strong> {{ this.message }}
          </span>
          {{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </div>
    {{/if}}
    {{else}}
    {{#if strings.compatibilityHint}}
    <p class="hint sc-cae-compatibility-hint">
      <i class="fas fa-wand-magic-sparkles"></i>
      {{ strings.compatibilityHint }}
    </p>
    {{/if}}

    {{#if conditionInvalid}}
    <p class="notification warning sc-cae-validation-warning">
      <i class="fas fa-triangle-exclamation"></i>
      {{ strings.invalid }} {{ validationMessage }}
    </p>
    {{/if}}

    <details class="sc-cae-evaluation sc-cae-evaluation--{{ evaluation.state }}">
      <summary class="sc-cae-evaluation__header">{{ strings.evaluationHeading }}</summary>
      <div class="sc-cae-evaluation__body">
      <p class="hint sc-cae-evaluation__message">
        {{#if evaluation.isEmpty}}
        {{ strings.evaluationEmpty }}
        {{else}}
          {{#if evaluation.isTrue}}
          {{ strings.evaluationTrue }}
          {{else}}
            {{#if evaluation.isFalse}}
            {{ strings.evaluationFalse }}
            {{else}}
            {{ strings.evaluationError }} {{ evaluation.errorMessage }}
            {{/if}}
          {{/if}}
        {{/if}}
      </p>
      {{#if evaluation.hasResult}}
      <p class="hint sc-cae-evaluation__detail">
        <strong>{{ strings.evaluationResult }}:</strong>
        <code>{{ evaluation.resultLabel }}</code>
      </p>
      {{/if}}
      {{#if evaluation.contextLabel}}
      <p class="hint sc-cae-evaluation__detail">
        <strong>{{ strings.evaluationContext }}:</strong>
        {{ evaluation.contextLabel }}
      </p>
      {{/if}}
      {{#if evaluation.effectStateLabel}}
      <p class="hint sc-cae-evaluation__detail">
        <strong>{{ strings.evaluationEffectState }}:</strong>
        <code>{{ evaluation.effectStateLabel }}</code>
      </p>
      {{/if}}
      </div>
    </details>
    {{/if}}

    <div class="form-group">
      <label>{{ strings.conditionBehavior }}</label>
      <div class="form-fields">
        {{#if editable}}
        <select name="{{ conditionBehaviorFlagPath }}">
          <option value="suppress" {{#if conditionBehaviorIsSuppress}}selected{{/if}}>{{ strings.conditionBehaviorSuppress }}</option>
          <option value="disable" {{#if conditionBehaviorIsDisable}}selected{{/if}}>{{ strings.conditionBehaviorDisable }}</option>
        </select>
        {{else}}
        <select disabled>
          <option value="suppress" {{#if conditionBehaviorIsSuppress}}selected{{/if}}>{{ strings.conditionBehaviorSuppress }}</option>
          <option value="disable" {{#if conditionBehaviorIsDisable}}selected{{/if}}>{{ strings.conditionBehaviorDisable }}</option>
        </select>
        {{/if}}
      </div>
      <p class="hint">{{ strings.conditionBehaviorHint }}</p>
      {{#if conditionUsesTokenContext}}
      <p class="hint sc-cae-compatibility-hint">
        <i class="fas fa-location-dot"></i>
        {{ strings.spatialConditionBehaviorHint }}
      </p>
      {{/if}}
    </div>

    <div class="form-group sc-cae-badge-label-group">
      <label>{{ strings.badgeLabel }}</label>
      <div class="form-fields">
        {{#if editable}}
        <input
          type="text"
          name="{{ conditionBadgeLabelFlagPath }}"
          value="{{ conditionBadgeLabel }}"
          maxlength="{{ badgeLabelMaxLength }}"
          placeholder="{{ strings.badgeLabelPlaceholder }}"
          class="sc-cae-badge-label-input"
        />
        {{else}}
        <input
          type="text"
          value="{{ conditionBadgeLabel }}"
          class="sc-cae-badge-label-input"
          disabled
        />
        {{/if}}
        <span class="sc-cae-badge-label-counter">{{ conditionBadgeLabelLength }}/{{ badgeLabelMaxLength }}</span>
      </div>
      <p class="hint">{{ strings.badgeLabelHint }}</p>
    </div>

    <div class="form-group">
      <label>{{ strings.applyBehavior }}</label>
      <div class="form-fields">
        {{#if editable}}
        <select name="{{ applyBehaviorFlagPath }}">
          <option value="auto" {{#if applyBehaviorIsDefault}}selected{{/if}}>{{ strings.applyBehaviorUpdate }}</option>
          <option value="duplicate" {{#if applyBehaviorIsDuplicate}}selected{{/if}}>{{ strings.applyBehaviorDuplicate }}</option>
          {{#if showDaeApplyBehavior}}
          <option value="dae" {{#if applyBehaviorIsDae}}selected{{/if}}>{{ strings.applyBehaviorDae }}</option>
          {{/if}}
        </select>
        {{else}}
        <input
          type="text"
          value="{{ applyBehavior }}"
          disabled
        />
        {{/if}}
      </div>
      <p class="hint" data-sc-cae-apply-behavior-hint>{{ applyBehaviorDescription }}</p>
    </div>

    {{#unless useNativeAdvancedEditor}}
    <div class="sc-cae-code-header">
      <div class="sc-cae-code-header-title">
        <span>{{ strings.label }}</span>
        <i
          class="fa-solid fa-circle-info sc-cae-code-help-icon"
          data-tooltip="{{ codeHelpTooltip }}"
          data-tooltip-direction="UP"
          aria-label="{{ strings.helpTooltipLabel }}"
        ></i>
      </div>
      <a class="sc-cae-help-link" href="{{ conditionWikiUrl }}" target="_blank" rel="noopener">
        <i class="fas fa-up-right-from-square"></i> {{ strings.wiki }}
      </a>
    </div>

    {{#if editable}}
    <div class="sc-cae-variable-popover" data-sc-cae-variable-popover>
      <button
        type="button"
        class="sc-cae-variable-trigger"
        data-sc-cae-variable-trigger
        aria-haspopup="dialog"
        aria-expanded="false"
        data-tooltip="{{ strings.variableToolbarHint }}"
      >
        <i class="fa-solid fa-brackets-curly"></i>
        <span>{{ strings.insertVariable }}</span>
        <i class="fa-solid fa-chevron-down sc-cae-variable-trigger__caret"></i>
      </button>

      <div
        class="sc-cae-variable-panel"
        data-sc-cae-variable-panel
        role="dialog"
        aria-label="{{ strings.variableToolbarLabel }}"
      >
        <div class="sc-cae-variable-panel__search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input
            type="text"
            class="sc-cae-variable-search"
            data-sc-cae-variable-search
            placeholder="{{ strings.variableSearchPlaceholder }}"
            aria-label="{{ strings.variableSearchPlaceholder }}"
            spellcheck="false"
            autocomplete="off"
          />
        </div>

        <ul class="sc-cae-variable-list" data-sc-cae-variable-list>
          {{#each conditionVariables}}
          <li>
            <button
              type="button"
              class="sc-cae-variable-option"
              data-sc-cae-insert-variable="{{ this.name }}"
              data-sc-cae-variable-search="{{ this.searchText }}"
            >
              <span class="sc-cae-variable-option__head">
                <code>{{ this.name }}</code>
                <span class="sc-cae-variable-option__kind">{{ this.kindLabel }}</span>
              </span>
              <span class="sc-cae-variable-option__description">{{ this.description }}</span>
            </button>
          </li>
          {{/each}}
        </ul>

        <p class="hint sc-cae-variable-empty sc-cae-variable-option--hidden" data-sc-cae-variable-empty>
          {{ strings.variableSearchEmpty }}
        </p>
      </div>
    </div>
    <code-mirror
      name="{{ conditionFlagPath }}"
      language="javascript"
      indent="2"
      class="sc-cae-condition-code"
      aria-label="{{ strings.label }}"
    >{{ conditionInputValue }}</code-mirror>
    {{else}}
    <textarea
      name="{{ conditionFlagPath }}"
      class="sc-cae-condition-code sc-cae-condition-code--readonly"
      rows="10"
      placeholder="{{ strings.placeholder }}"
      disabled>{{ conditionInputValue }}</textarea>
    {{/if}}
    {{/unless}}
  </fieldset>
</section>
